@model IEnumerable<SecureSeat.Models.Show>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">SecureSeat</h1>
    <p class="lead">Your trusted platform for secure event ticketing.</p>
    <h3 class="display-6 pt-3">Upcoming Events</h3>
    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4 p-5">
    @foreach (var eventItem in Model)

    {
        
            <div class="card h-100 box-shadow w-25">
               <img src="@eventItem.ImageUrl" class="card-img-top" alt="@eventItem.Title" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    
                    <h6 class="card-text">@eventItem.Category</h6>
                    <p class="card-text">@eventItem.Description</p>
                    <p class="card-text"><strong>Date:</strong> @eventItem.Date.ToString("MMMM dd, yyyy")</p>
                    <p class="card-text"><strong>Time:</strong> @eventItem.Time.ToString(@"hh\:mm")</p>
                    <p class="card-text"><strong>Location:</strong> @eventItem.Location</p>
                </div>
            </div>
    
        
    }
    </div>
</div>
