@model IEnumerable<SecureSeat.Models.Show>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">New Event</a>
</div>

<div class="list-group">
    @foreach (var item in Model)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-1">@item.Title</h5>
                    <p class="mb-1">@item.Date.ToString("MMM dd") • @item.Location</p>
                    <small>@item.Category • @item.Owner</small>
                </div>
                <div class="btn-group">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>