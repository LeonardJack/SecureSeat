@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <h1 class="text-danger">Access Denied</h1>
        <div class="alert alert-warning mt-4">
            <h4>You don't have permission to access this page.</h4>
            <p class="mb-0">Please contact an administrator if you believe this is an error.</p>
        </div>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
            <a asp-controller="Login" asp-action="Login" class="btn btn-secondary">Login with Different Account</a>
        </div>
    </div>
</div>
